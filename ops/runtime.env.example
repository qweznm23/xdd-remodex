# systemd EnvironmentFile syntax. Replace paths/addresses for your host.
# On Linux/macOS the standard socket under the bridge user's CODEX_HOME
# supports automatic wake using "codex app-server daemon start". Custom
# socket paths and TCP endpoints are connection-only.
REMODEX_CODEX_ENDPOINT=ws+unix:///home/user/.codex/app-server-control/app-server-control.sock:/
REMODEX_RELAY=ws://127.0.0.1:10004/relay
REMODEX_RUNTIME_DIR=/path/to/xdd-remodex/.local/runtime
REMODEX_DEVICE_STATE_DIR=/path/to/xdd-remodex/.local/runtime/state
REMODEX_DOWNLOAD_PAGE_URL=https://github.com/qweznm23/xdd-remodex/releases/latest
REMODEX_AUTH_SCHEDULE_ENABLED=1
REMODEX_FILE_STREAM_PORT=19094
REMODEX_IMAGE_PYTHON=/usr/bin/python3
PORT=10004
RELAY_BIND_HOST=127.0.0.1
REMODEX_FILE_ORIGIN=http://127.0.0.1:19094
# Optional: local Android release directory, served at /updates/ on the relay.
REMODEX_UPDATE_DIR=/path/to/xdd-remodex/.local/artifacts/downloads
# Existing installations only: also serve old download links on the same process.
# UPDATE_PORT=19093
# UPDATE_BIND=127.0.0.1
