# systemd EnvironmentFile syntax. Replace paths/addresses for your host.
REMODEX_CODEX_ENDPOINT=ws+unix:///home/user/.codex/app-server-control/app-server-control.sock:/
REMODEX_RELAY=ws://127.0.0.1:10004/relay
REMODEX_RUNTIME_DIR=/path/to/xdd-remodex/.local/runtime
REMODEX_DEVICE_STATE_DIR=/path/to/xdd-remodex/.local/runtime/state
REMODEX_DOWNLOAD_PAGE_URL=http://127.0.0.1:19093/
REMODEX_AUTH_SCHEDULE_ENABLED=1
REMODEX_FILE_STREAM_PORT=19094
REMODEX_IMAGE_PYTHON=/usr/bin/python3
PORT=10004
RELAY_BIND_HOST=127.0.0.1
REMODEX_FILE_ORIGIN=http://127.0.0.1:19094
REMODEX_UPDATE_ORIGIN=http://127.0.0.1:19093
UPDATE_PORT=19093
UPDATE_BIND=127.0.0.1
