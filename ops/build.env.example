# Copy to .local/config/build.env. This file is sourced by local shell scripts.
JAVA_HOME=/path/to/jdk-21
ANDROID_HOME=/path/to/android-sdk
ANDROID_BUILD_TOOLS=35.0.0
# GRADLE_USER_HOME defaults to this repository's .local/cache/gradle.
GRADLE_PROXY_HOST=127.0.0.1
GRADLE_PROXY_PORT=7897
# Set this to your own update endpoint. Never put signing secrets here in Git.
APP_UPDATE_URL=http://127.0.0.1:19093/update.json
